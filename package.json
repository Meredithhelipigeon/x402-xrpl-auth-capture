{
  "name": "x402-xrpl-auth-capture-workspace",
  "private": true,
  "description": "x402 auth-capture scheme binding for the XRP Ledger (native Escrow), with arbiter-based verify-then-pay demo apps",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r --filter ./packages/** test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
