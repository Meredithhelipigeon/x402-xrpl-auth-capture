{
  "name": "x402-xrpl-auth-capture-workspace",
  "private": true,
  "description": "x402 auth-capture scheme binding for the XRP Ledger (native Escrow), with arbiter-based verify-then-pay demo apps",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r --filter ./packages/** test",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "testnet:setup": "NODE_USE_ENV_PROXY=1 tsx scripts/setup-testnet.ts",
    "testnet:raw-escrow": "NODE_USE_ENV_PROXY=1 tsx scripts/raw-escrow.ts",
    "testnet:reclaim-expired": "NODE_USE_ENV_PROXY=1 tsx scripts/reclaim-expired.ts",
    "facilitator": "pnpm --filter @demo/facilitator start",
    "testnet:settle-escrow": "NODE_USE_ENV_PROXY=1 tsx --conditions=source scripts/settle-escrow.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "https-proxy-agent": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "xrpl": "^5.3.0",
    "@xrpljapan/x402-xrpl": "^0.1.0"
  }
}
