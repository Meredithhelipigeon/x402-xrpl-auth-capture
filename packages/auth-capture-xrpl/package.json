{
  "name": "x402-auth-capture-xrpl",
  "version": "0.0.0",
  "private": true,
  "description": "XRPL network binding of the x402 auth-capture scheme (native Escrow hold, arbiter-held capture)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@x402/core": ">=2.28.0"
  },
  "dependencies": {
    "@xrpljapan/x402-xrpl": "^0.1.0",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@x402/core": "2.28.0",
    "five-bells-condition": "^5.0.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
