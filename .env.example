# Copy to .env (gitignored). scripts/setup-testnet.ts writes the real values.
# Testnet only. Never reuse these accounts on mainnet (see AGENTS.md section 2).

XRPL_NETWORK=xrpl:1
XRPL_WS_URL=wss://testnet.xrpl-labs.com

BUYER_ADDRESS=
BUYER_SEED=
SELLER_ADDRESS=
SELLER_SEED=
ARBITER_ADDRESS=
ARBITER_SEED=
FACILITATOR_ADDRESS=
FACILITATOR_SEED=

# Misa runs the checks when set (https://api.trymisa.com once sponge-ai-lab/misa#241 is deployed),
# against the seller's Misa listing MISA_LISTING_SLUG (imported from the seller's /openapi.json).
# Unset: the arbiter's local stand-in reads the schema from the seller's /openapi.json itself.
MISA_CHECKS_URL=
MISA_LISTING_SLUG=hold-my-drops-quotes
